# LLM provider: "ollama" (default, local) or "openai_compat" (hosted open-source model via an OpenAI-compatible API)
LLM_PROVIDER=ollama

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M

# --- OpenAI-compatible hosted endpoint (Groq / Together / OpenRouter / Fireworks, etc.) ---
# Only needed if LLM_PROVIDER=openai_compat. Never commit real values.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# --- Alerting (v1.5) ---
SLACK_WEBHOOK_URL=

# --- Storage ---
DATA_DIR=./data
